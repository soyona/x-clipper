{
  "manifest_version": 3,
  "name": "X Article Clipper",
  "short_name": "X Clipper",
  "version": "1.1.1",
  "description": "Save valuable X Posts and Articles locally for focused reading and creative work.",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "scripting"],
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://pbs.twimg.com/*"
  ],
  "action": {
    "default_title": "Open X Article Clipper",
    "default_icon": {
      "16": "assets/icons/x-clipper-icon-16.png",
      "32": "assets/icons/x-clipper-icon-32.png",
      "48": "assets/icons/x-clipper-icon-48.png",
      "128": "assets/icons/x-clipper-icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "assets/icons/x-clipper-icon-16.png",
    "32": "assets/icons/x-clipper-icon-32.png",
    "48": "assets/icons/x-clipper-icon-48.png",
    "128": "assets/icons/x-clipper-icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": ["i18n.js", "markdown.js", "post-snapshot.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
